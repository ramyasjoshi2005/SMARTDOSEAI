# Copy to .env for local use. On Render, set these in the dashboard.
# Do not commit real values.

SECRET_KEY=change-me-to-a-long-random-string
PORT=5000
FLASK_DEBUG=0

# Optional: persistent disk mount on Render (uploads, generated PDFs, patients.json writes)
# DATA_DIR=/var/data

# Optional: Tesseract binary (Linux on Render usually uses PATH; Windows local path is auto-detected)
# TESSERACT_CMD=tesseract

# Demo logins — override in production. Defaults match the current local accounts.
RECEPTION_USERNAME=reception
RECEPTION_PASSWORD=change-me
DOCTOR_SHARMA_USERNAME=drsharma
DOCTOR_SHARMA_PASSWORD=change-me
DOCTOR_PRIYA_USERNAME=drpriya
DOCTOR_PRIYA_PASSWORD=change-me
DOCTOR_MEHTA_USERNAME=drmehta
DOCTOR_MEHTA_PASSWORD=change-me
DOCTOR_REDDY_USERNAME=drreddy
DOCTOR_REDDY_PASSWORD=change-me
